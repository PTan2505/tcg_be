# Card Number Cache (controls for remote cache and memory optimizations)
# Set CARD_NUMBER_CACHE_URL to fetch the prebuilt cache from (optional).
# If not set, the application may fallback to building from DB or a default URL.
CARD_NUMBER_CACHE_URL=https://tcg-app-s3.s3.ap-southeast-1.amazonaws.com/cache/card-numbers-cache.json
FUSE_CARDS_POKEMON_URL=https://tcg-app-s3.s3.ap-southeast-1.amazonaws.com/cache/3dd852a3-4ffe-44eb-b9d6-8a3969e6279b-fuse-cards-pokemon.json
FUSE_CARDS_YUGIOH_URL=https://tcg-app-s3.s3.ap-southeast-1.amazonaws.com/cache/125e49d6-dccf-44a1-903c-99f5e2f18cf5-fuse-cards-yugioh.json
FUSE_CARDS_ONEPIECE_URL=https://tcg-app-s3.s3.ap-southeast-1.amazonaws.com/cache/8a58b140-6fb0-4c20-bd47-1bdfdb48b1e9-fuse-cards-onepiece.json
AI_MEMORY_CACHE_URL=https://tcg-app-s3.s3.ap-southeast-1.amazonaws.com/cache/1f51a8d2-cc0e-4884-b295-3e57b35de604-ai-memory.json
# When set to 1, the app will use an existing cache as-is and will not rebuild it automatically.
CARD_NUMBER_CACHE_STRICT=0
# When set to 1, keep a lean in-memory representation (IDs + minimal metadata).
CARD_NUMBER_CACHE_LEAN=0
# Time-to-live (hours) for the cache when not in strict mode. Default: 24
CARD_NUMBER_CACHE_TTL_HOURS=24
# If PRELOAD_CACHES=1 the app will preload heavy caches (AI memory, card-number cache) at startup.
# Leave unset or 0 to skip preloading and initialize lazily on first use.
PRELOAD_CACHES=0

# WebSocket Configuration
# Use a separate port for the standalone WS server to avoid conflicts with the HTTP server.
WEBSOCKET_PORT=8080

