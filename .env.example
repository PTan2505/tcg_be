# Database Configuration
DATABASE_NAME=tcg_db
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=27017

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EMAIL_SECRET=your_jwt_email_secret

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# Application
APP_URL=http://localhost:3000
# Note: Rename this file to .env and replace placeholder values with actual configuration before running the application.

# Superuser Configuration for Testing and Administration
SUPERUSER_EMAIL=superadmin@gmail.com
SUPERUSER_PASSWORD=Admin123